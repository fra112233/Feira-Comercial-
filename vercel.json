{
  "buildCommand": "echo \"{\\\"versao\\\":\\\"${VERCEL_GIT_COMMIT_SHA:-$(date +%s)}\\\"}\" > version.json",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "feira-comercialcom.vercel.app"
        }
      ],
      "destination": "https://www.feira-comercial.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "feira-comercial-teste.vercel.app"
        }
      ],
      "destination": "https://www.feira-comercial.com/:path*",
      "permanent": true
    }
  ]
}