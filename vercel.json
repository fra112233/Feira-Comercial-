{
  "buildCommand": "echo \"{\\\"versao\\\":\\\"${VERCEL_GIT_COMMIT_SHA:-$(date +%s)}\\\"}\" > version.json",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), bluetooth=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://kit.fontawesome.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.googleapis.com https://ka-f.fontawesome.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com https://ka-f.fontawesome.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://bljnkwrhqnpawclybqrw.supabase.co; connect-src 'self' https://bljnkwrhqnpawclybqrw.supabase.co wss://bljnkwrhqnpawclybqrw.supabase.co https://nominatim.openstreetmap.org https://ka-f.fontawesome.com https://cdn.jsdelivr.net; frame-src https://www.google.com https://maps.google.com https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap-lojas.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap-loja.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "feira-comercialcom.vercel.app"
        }
      ],
      "destination": "https://www.feira-comercial.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "feira-comercial-teste.vercel.app"
        }
      ],
      "destination": "https://www.feira-comercial.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap-lojas.xml",
      "destination": "https://bljnkwrhqnpawclybqrw.supabase.co/functions/v1/sitemap-lojas"
    },
    {
      "source": "/sitemap-loja.xml",
      "destination": "https://bljnkwrhqnpawclybqrw.supabase.co/functions/v1/sitemap-lojas"
    },
    {
      "source": "/loja/:id",
      "destination": "/api/loja?id=:id"
    }
  ]
}
